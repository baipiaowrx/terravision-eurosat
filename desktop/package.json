{
  "name": "terravision-desktop",
  "version": "1.0.0",
  "description": "Terravision 遥感图像多标签分类系统 - 桌面端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win dir --x64"
  },
  "build": {
    "appId": "com.terravision.desktop",
    "productName": "Terravision",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "assets/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "electron-packager": "^18.1.0",
    "sharp": "^0.35.2"
  },
  "author": "W"
}